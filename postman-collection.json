{
  "info": {
    "name": "GitHub Profile Analyzer API",
    "description": "A collection for testing the GitHub Profile Analyzer API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Check if the API server is running"
      }
    },
    {
      "name": "Analyze GitHub Profile",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles/analyze/:username",
          "host": ["{{baseUrl}}"],
          "path": ["api", "profiles", "analyze", ":username"],
          "variable": [
            {
              "key": "username",
              "value": "octocat",
              "description": "GitHub username to analyze"
            }
          ]
        },
        "description": "Fetch and analyze a GitHub user profile, then store it in the database"
      }
    },
    {
      "name": "Get All Profiles",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles",
          "host": ["{{baseUrl}}"],
          "path": ["api", "profiles"]
        },
        "description": "Retrieve all stored profiles from the database"
      }
    },
    {
      "name": "Get Profile by Username",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles/username/:username",
          "host": ["{{baseUrl}}"],
          "path": ["api", "profiles", "username", ":username"],
          "variable": [
            {
              "key": "username",
              "value": "octocat",
              "description": "GitHub username to fetch"
            }
          ]
        },
        "description": "Retrieve a specific profile by GitHub username"
      }
    },
    {
      "name": "Get Profile by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles/:id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "profiles", ":id"],
          "variable": [
            {
              "key": "id",
              "value": "1",
              "description": "Database ID of the profile"
            }
          ]
        },
        "description": "Retrieve a specific profile by database ID"
      }
    },
    {
      "name": "Delete Profile",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/profiles/:username",
          "host": ["{{baseUrl}}"],
          "path": ["api", "profiles", ":username"],
          "variable": [
            {
              "key": "username",
              "value": "octocat",
              "description": "GitHub username to delete"
            }
          ]
        },
        "description": "Delete a profile from the database by username"
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
